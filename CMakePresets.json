{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_C_COMPILER": "cl.exe", "CMAKE_CXX_COMPILER": "cl.exe" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug (praca nad programem)",
      "description": "Wolniejsza wersja z pełnym debugowaniem — tylko na tym komputerze.",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release (wersja do przenoszenia)",
      "description": "Szybka wersja do skopiowania na inne komputery z Windows (korektor.exe + pdfium.dll).",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "displayName": "x64 Debug", "configurePreset": "x64-debug" },
    { "name": "x64-release", "displayName": "x64 Release", "configurePreset": "x64-release" }
  ]
}
